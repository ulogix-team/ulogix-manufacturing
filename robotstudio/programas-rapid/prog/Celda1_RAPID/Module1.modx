    PROC main()
        SetDO DO_ST_Conveyor,0;
        SetDO DO_Gripper_On,0;
        SetDO DO_Gripper_Off,0;
        SetDO DO_ST_Pick,0;
        SetDO DO_ST_Conveyor2,0;
        SetDO DO_ST_Pick2,0;
        SetDO DO_ST_Detach,0;
        SetDO DO_ST_Detach2,0;
        
        !Ciclo 1 Pallet 1
        WaitUntil DI_Start=1;
        SetDO DO_ST_Conveyor,1;
        WaitUntil DI_OnPosition=1;
        Path_10;
        SetDO DO_ST_Pick,1;
        WaitUntil DI_OnAttach=1;
        SetDO DO_ST_Conveyor2,1;
        Path_20;
        SetDO DO_Gripper_Off,0;
