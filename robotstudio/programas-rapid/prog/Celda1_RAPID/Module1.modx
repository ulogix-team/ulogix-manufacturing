        SetDO DO_Gripper_Off,0;
        SetDO DO_ST_Pick,0;
        SetDO DO_ST_Conveyor2,0;
        SetDO DO_ST_Pick2,0;
        SetDO DO_ST_Detach,0;
        SetDO DO_ST_Detach2,0;
    ENDPROC
    PROC UpdateSpeed()
        vel_gantry := [600, 500, SpeedValue, 400];
        vel_gantry_p := [600, 500, 400, 400];
    ENDPROC
    PROC Path_10()
        UpdateSpeed;
        SetDO DO_Gripper_Res,1;
        SetDO DO_Gripper_Res,0;
        MoveAbsJ jT_Pick,vel_gantry_p,fine,Tool\WObj:=Workobject_1;
        SetDO DO_Gripper_On,0;
        SetDO DO_Gripper_Off,1;
        WaitTime 1;
        WaitUntil DI_Gripper_Executed=1;
    ENDPROC
    PROC Path_20()
        UpdateSpeed;
