        Path_130;
        Path_140;
        Path_50;
        Path_10;
        Path_150;
        Path_160;
        Path_170;
        Path_50;
        Path_10;
        Path_150;
        Path_160;
        Path_170;
        Path_50;
        
        SetDO DO_Gripper,1;
        
        SetDO DO_ST_Conveyor,0;
        SetDO DO_ST_Pick,0;
        SetDO DO_ST_Dettach,0;
        SetDO DO_End_Cycle1,0;
        SetDO DO_ST_Conveyor2,0;
        SetDO DO_ST_Pick2,0;
        SetDO DO_ST_Dettach2,0;
        SetDO DO_ST_Move,0;
    ENDPROC
    
    PROC UpdateSpeed()
        Speed := [SpeedValue,SpeedValue,5000,1000];
    ENDPROC

    PROC Before_Pick()
        UpdateSpeed;
        MoveJ Home,Speed,z10,Tool\WObj:=Workobject_1;
        MoveJ T_BPick,Speed,z10,Tool\WObj:=Workobject_1;
    ENDPROC
    PROC Path()
        UpdateSpeed;
        MoveJ T_BPick,Speed,z10,Tool\WObj:=Workobject_1;
        MoveJ T_Pick,Speed,fine,Tool\WObj:=Workobject_1;
        SetDO DO_Gripper,1;
    ENDPROC
    PROC Path_10()
        UpdateSpeed;
        MoveJ T_Pick,Speed,fine,Tool\WObj:=Workobject_1;
        MoveJ T_Pick2,Speed,z10,Tool\WObj:=Workobject_1;
    ENDPROC
    PROC Path_20()
        UpdateSpeed;
        ConfL\Off;
        MoveL T_Pick2,Speed,z10,Tool\WObj:=Workobject_1;
        MoveL T_Rack11,Speed,fine,Tool\WObj:=Workobject_1;
    ENDPROC
    PROC Path_30()
        UpdateSpeed;
        MoveL T_Rack11,Speed,fine,Tool\WObj:=Workobject_1;
        MoveL T_Rack12,Speed,fine,Tool\WObj:=Workobject_1;
        SetDO DO_Gripper,0;
    ENDPROC
    PROC Path_40()
        UpdateSpeed;
        MoveL T_Rack11,Speed,fine,Tool\WObj:=Workobject_1;
        ConfL\On;
    ENDPROC
    PROC Path_50()
