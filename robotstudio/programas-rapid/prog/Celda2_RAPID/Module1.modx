    PROC main()
        SetDO DO_ST_Conveyor,0;
        SetDO DO_ST_Pick,0;
        SetDO DO_ST_Dettach,0;
        SetDO DO_End_Cycle1,0;
        SetDO DO_ST_Conveyor2,0;
        SetDO DO_ST_Pick2,0;
        SetDO DO_ST_Dettach2,0;
        SetDO DO_ST_Move,0;
        
        SetDO DO_Time_Pallet, 1;
        
        WaitUntil DI_Start=1;
        SetDO DO_ST_Conveyor,1;
        Before_Pick;
        Path;
        SetDO DO_ST_Pick,1;
        WaitUntil DI_OnAttach=1;
        Path_10;
        SetDO DO_ST_Conveyor2,1;
        Path_20;
        Path_30;
        SetDO DO_ST_Dettach,1;
        Path_40;
        Path_50;
        SetDO DO_ST_Pick2,1;
        WaitUntil DI_OnAttach2=1;
        Path_10;
        Path_20;
        WaitTime 0.3;
        SetDO DO_ST_Move,1;
        Path_30;
        SetDO DO_ST_Dettach2,1;
        Path_40;
        Path_50;
        Path_10;
        Path_60;
        Path_70;
        Path_80;
        Path_50;
        Path_10;
        Path_60;
        Path_70;
        Path_80;
        Path_50;
